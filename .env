# Backend API
VITE_API_BASE_URL=https://cms.blueorbits.com/api/v1

# Frontend App URL (Required for redirect_uri)
VITE_APP_URL=http://localhost:5173

# Keycloak Configuration
# Example: https://keycloak.example.com/realms/hijama-clinic/protocol/openid-connect/auth
VITE_KEYCLOAK_AUTH_URL=https://cms-auth.blueorbits.com/realms/hijama-clinic/protocol/openid-connect/auth
VITE_KEYCLOAK_CLIENT_ID=hijama-clinic